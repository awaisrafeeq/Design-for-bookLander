  "brand": {
    "voice": "Calm, plain and specific. Short sentences. Talk to one reader, not a crowd. Never sound like a shop trying to be clever.",
    "never": [
      "Invent a review or testimonial",
      "Say a title is in stock without checking",
      "Use fake urgency or countdowns",
      "Promise a delivery date",
      "Offer a discount a person did not approve"
    ],
    "styles": [
      {
        "format": "video",
        "name": "Reader voice",
        "guidance": "One person in a normal room, talking to camera. The book is held, not displayed. Under 30 seconds."
      },
      {
        "format": "carousel",
        "name": "Cover-forward",
        "guidance": "The real cover fills most of each slide. One short line of text. No stock photos."
      },
      {
        "format": "image",
        "name": "Quiet editorial",
        "guidance": "Lots of empty space. One cover, small and off centre. One plain line."
      }
