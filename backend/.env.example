APP_ENV=production
APP_NAME=BookLender Studio API
API_PREFIX=/api/v1
BOOKLENDER_DOMAIN=replace-with-your-studio-domain.com
DATABASE_URL=postgresql+psycopg://booklender:change-me@localhost:5432/booklender
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
SESSION_COOKIE_NAME=bl_session
SESSION_TTL_HOURS=12
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
COOKIE_SECURE=true
ALLOWED_ORIGINS=["https://replace-with-your-studio-domain.com"]
BOOTSTRAP_ADMIN_EMAIL=bookadmin@example.com
# Set a unique password locally. Never commit a real value.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOKLENDER_TIMEZONE=America/New_York
AI_DAILY_SPEND_CAP_USD=5
