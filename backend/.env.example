APP_ENV=production
APP_NAME=BookLender Studio API
API_PREFIX=/api/v1
# Production domain: point its DNS A record at the VPS before deploying.
BOOKLENDER_CADDY_ADDRESS=booklender.tech
PUBLIC_APP_URL=https://booklender.tech
DATABASE_URL=postgresql+psycopg://REPLACE_USER:URL_ENCODED_PASSWORD@postgresql-oao5-postgresql-1:5432/REPLACE_DB
REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_NAME=bl_session
SESSION_TTL_HOURS=12
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
COOKIE_SECURE=true
ALLOWED_ORIGINS=["https://booklender.tech"]
BOOTSTRAP_ADMIN_EMAIL=bookadmin@booklender.com
# Set a unique password locally. Never commit a real value.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOKLENDER_TIMEZONE=America/New_York
AI_DAILY_SPEND_CAP_USD=5
# Daily cap enforcement remains deferred pending client confirmation. Actual text usage is recorded.
OPENROUTER_API_KEY=
# Set an explicit model available to your OpenRouter account; no paid model is silently selected.
OPENROUTER_MODEL=
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
ZERNIO_WEBHOOK_SECRET=
PREDIS_API_KEY=
PREDIS_BRAND_ID=
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_TTS_ACCENT=
MEDIA_SIGNING_KEY=
MEDIA_MAX_UPLOAD_MB=100
# Enter sender settings from your email mailbox/provider when available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
