APP_ENV=staging
APP_NAME=BookLender Studio API
API_PREFIX=/api/v1
# Temporary IP-only access: HTTP has no TLS. Use only for smoke testing.
BOOKLENDER_CADDY_ADDRESS=http://2.25.242.183
DATABASE_URL=postgresql+psycopg://REPLACE_USER:URL_ENCODED_PASSWORD@postgresql-oao5-postgresql-1:5432/REPLACE_DB
REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_NAME=bl_session
SESSION_TTL_HOURS=12
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://2.25.242.183"]
BOOTSTRAP_ADMIN_EMAIL=bookadmin@example.com
# Set a unique password locally. Never commit a real value.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOKLENDER_TIMEZONE=America/New_York
AI_DAILY_SPEND_CAP_USD=5
# After adding a domain and DNS A record, use:
# APP_ENV=production
# BOOKLENDER_CADDY_ADDRESS=studio.your-domain.com
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=["https://studio.your-domain.com"]
